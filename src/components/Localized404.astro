---
/**
 * Contenido de la 404 localizada. Lo usan las tres 404 prerenderizadas
 * (en/404, es/404, pt/404) y el catch-all [...slug].astro, que sirve esta
 * pagina con estado 404 para cualquier ruta inexistente en el servidor propio.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

type Lang = 'en' | 'es' | 'pt';

const { lang }: { lang: Lang } = Astro.props;

const t = {
  en: {
    title: 'Page not found',
    description: "The requested page does not exist or has been moved. Return to the home page or contact us.",
    h1: "We couldn't find this page",
    lede: "The link may be broken or the page may have been moved. Return to the home page or write to us and we'll point you in the right direction.",
    home: 'Go to the home page',
    contact: 'Contact us',
    homeHref: '/',
    contactHref: '/contact',
  },
  es: {
    title: 'Página no encontrada',
    description: 'La página solicitada no existe o ha sido movida. Vuelva al inicio o contacte con nosotros.',
    h1: 'No hemos encontrado esta página',
    lede: 'El enlace puede estar roto o la página ha sido movida. Vuelva al inicio o escríbanos y le indicaremos el buen camino.',
    home: 'Ir a la página de inicio',
    contact: 'Contactar con nosotros',
    homeHref: '/es/',
    contactHref: '/es/contact',
  },
  pt: {
    title: 'Página não encontrada',
    description: 'A página solicitada não existe ou foi movida. Volte à página inicial ou contacte-nos.',
    h1: 'Não encontrámos esta página',
    lede: 'A ligação pode estar partida ou a página foi movida. Volte à página inicial ou escreva-nos e indicar-lhe-emos o caminho certo.',
    home: 'Ir para a página inicial',
    contact: 'Contactar connosco',
    homeHref: '/pt/',
    contactHref: '/pt/contact',
  },
}[lang];
---

<BaseLayout lang={lang} noindex title={t.title} description={t.description}>
  <section class="section error-page">
    <div class="container error-page__inner">
      <p class="error-page__code" aria-hidden="true">404</p>

      <div class="error-page__block" lang={lang}>
        <p class="overline">Error 404</p>
        <h1>{t.h1}</h1>
        <p class="lede">
          {t.lede}
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={t.homeHref}>{t.home}</a>
          <a class="btn btn--secondary" href={t.contactHref}>{t.contact}</a>
        </div>
      </div>

      <svg
        class="causal-graph error-page__graph"
        viewBox="0 0 480 300"
        width="480"
        height="300"
        aria-hidden="true"
      >
        <path class="edge" d="M90 90 C 150 70, 190 70, 240 84"></path>
        <path class="edge" d="M240 84 C 300 96, 340 120, 386 150"></path>
        <path class="edge" d="M90 90 C 120 150, 140 190, 170 216"></path>
        <path class="edge" d="M170 216 C 240 250, 310 250, 372 236"></path>
        <path class="edge error-page__missing" d="M386 150 C 424 180, 436 214, 416 246" stroke-dasharray="2 8"></path>
        <circle class="node" cx="90" cy="90" r="14"></circle>
        <circle class="node node--accent" cx="240" cy="84" r="18"></circle>
        <circle class="node" cx="386" cy="150" r="14"></circle>
        <circle class="node" cx="170" cy="216" r="14"></circle>
        <circle class="node" cx="372" cy="236" r="14"></circle>
        <circle class="node node--lost" cx="420" cy="266" r="12"></circle>
      </svg>
    </div>
  </section>

  <script is:inline>
    // La 404 no tiene página espejo: cada opción del conmutador lleva a la home
    // de su idioma (aplica al conmutador del header y al del pie).
    var homes = { en: '/en/', es: '/es/', pt: '/pt/' };
    var fixHomes = function () {
      document.querySelectorAll('a[data-lang-switch]').forEach(function (link) {
        var code = link.getAttribute('hreflang');
        if (homes[code]) link.setAttribute('href', homes[code]);
      });
    };
    // El pie se renderiza despues de <main>: espera a que exista el DOM completo.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fixHomes);
    } else {
      fixHomes();
    }
  </script>
</BaseLayout>
