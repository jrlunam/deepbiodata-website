---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="pt"
  title="Contacto"
  description="Fale com a Deep Bio Data: colaborações em investigação clínica, análise de enviesamento, inferência causal e IA explicável para hospitais e instituições biomédicas."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="overline">Contacto</p>
        <h1>Falemos do seu projeto</h1>
        <p class="lede">
          Diga-nos que problema clínico ou de investigação quer abordar e
          responderemos com uma proposta de colaboração.
        </p>
      </div>

      <div class="contact-layout">
        <form
          name="contact"
          method="POST"
          novalidate
          class="card"
          style="padding: var(--space-6);"
        >
          <p style="display:none;">
            <label>Não preencher se é humano: <input name="bot-field" /></label>
          </p>

          <div class="form-grid">
            <div class="form-field">
              <label for="name">Nome e apelidos <span aria-hidden="true">*</span></label>
              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
                maxlength="80"
                aria-describedby="err-name"
              />
              <p class="form-error" id="err-name">Introduza o seu nome (letras e espaços, 2–80 caracteres).</p>
            </div>

            <div class="form-field">
              <label for="organisation">Organização</label>
              <input
                id="organisation"
                name="organisation"
                type="text"
                autocomplete="organization"
                maxlength="120"
                aria-describedby="err-organisation"
              />
              <p class="form-error" id="err-organisation">O nome da organização contém caracteres inválidos.</p>
            </div>

            <div class="form-field">
              <label for="email">Correio eletrónico <span aria-hidden="true">*</span></label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                spellcheck="false"
                required
                maxlength="254"
                aria-describedby="err-email"
              />
              <p class="form-error" id="err-email">Introduza um correio eletrónico válido (p. ex. nome@organizacao.com).</p>
            </div>

            <div class="form-field">
              <label for="phone">Telefone <span style="color: var(--color-text-muted); font-weight: 400;">(opcional)</span></label>
              <input
                id="phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                spellcheck="false"
                inputmode="tel"
                maxlength="20"
                pattern="\+?[\d\s().-]{9,20}"
                aria-describedby="err-phone"
              />
              <p class="form-error" id="err-phone">Introduza um telefone válido (apenas dígitos, espaços e + ( ) -).</p>
            </div>

            <div class="form-field">
              <label for="type">Tipo de colaboração <span aria-hidden="true">*</span></label>
              <select id="type" name="collaboration-type" required aria-describedby="err-type">
                <option value="" disabled selected>Selecione uma opção</option>
                <option value="hospital">Hospital / unidade de investigação clínica</option>
                <option value="institute">Instituto de investigação biomédica</option>
                <option value="university">Universidade / laboratório académico</option>
                <option value="programme">Programa de inovação (público ou privado)</option>
                <option value="other">Outro</option>
              </select>
              <p class="form-error" id="err-type">Selecione o tipo de colaboração.</p>
            </div>

            <div class="form-field form-field--full">
              <label for="message">Mensagem <span aria-hidden="true">*</span></label>
              <textarea
                id="message"
                name="message"
                required
                minlength="20"
                maxlength="2000"
                aria-describedby="err-message hint-message"></textarea>
              <span class="hint" id="hint-message">Descreva brevemente os seus dados, objetivos e prazos (20–2000 caracteres).</span>
              <p class="form-error" id="err-message">Escreva uma mensagem entre 20 e 2000 caracteres.</p>
            </div>

            <div class="form-field form-field--full">
              <div class="consent">
                <input id="consent" name="consent" type="checkbox" required aria-describedby="err-consent" />
                <label for="consent">
                  Li e aceito a <a href="/pt/privacy-policy">Política de Privacidade</a> e
                  consinto o tratamento dos meus dados para responder a este pedido. *
                </label>
              </div>
              <p class="form-error" id="err-consent">Aceite a Política de Privacidade para continuar.</p>
            </div>

            <div class="form-field form-field--full">
              <button class="btn btn--primary" type="submit">Enviar mensagem</button>
            </div>
          </div>

          <p class="form-status" role="alert" hidden></p>
        </form>

        <aside class="card" style="padding: var(--space-6);">
          <h3 style="margin-top:0;">Prefere o contacto direto?</h3>
          <p style="color: var(--color-text-muted); font-size: var(--fs-small);">
            Escreva ou ligue diretamente.
          </p>

          <div class="contact-method">
            <span class="contact-method__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </span>
            <div class="contact-method__text">
              <h3>Escreva-nos</h3>
              <a href="mailto:info@deepbiodata.com">info@deepbiodata.com</a>
              <p>Ideal para descrições detalhadas do projeto e anexos.</p>
            </div>
          </div>

          <div class="contact-method">
            <span class="contact-method__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/></svg>
            </span>
            <div class="contact-method__text">
              <h3>Ligue-nos</h3>
              <a href="tel:+351965636559">+351 965 636 559</a>
              <p>Linha direta com a equipa para uma primeira conversa.</p>
            </div>
          </div>

          <div class="contact-method">
            <span class="contact-method__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <div class="contact-method__text">
              <h3>Visite-nos</h3>
              <a
                href="https://www.google.com/maps/search/?api=1&amp;query=Rua%20Hermano%20Neves%2018%2C%201600-477%20Lisboa%2C%20Portugal"
                target="_blank"
                rel="noopener"
              >Rua Hermano Neves, Número 18, 3, Escritório 7, V6113<br />1600-477 Lisboa, Portugal</a>
              <p>O nosso escritório em Lisboa.</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <script>
    // Mesma lógica do formulário em inglês, com mensagens na marcação (err-*).
    const initForm = () => {
      const form = document.querySelector<HTMLFormElement>('form[name="contact"]');
      if (!form || form.hasAttribute('data-form-bound')) return;
      form.setAttribute('data-form-bound', '1');
      const status = form.querySelector('.form-status') as HTMLElement;
      const nameInput = form.querySelector<HTMLInputElement>('#name');
      const orgInput = form.querySelector<HTMLInputElement>('#organisation');
      const emailInput = form.querySelector<HTMLInputElement>('#email');
      const phoneInput = form.querySelector<HTMLInputElement>('#phone');
      const typeSelect = form.querySelector<HTMLSelectElement>('#type');
      const messageInput = form.querySelector<HTMLTextAreaElement>('#message');
      const consentInput = form.querySelector<HTMLInputElement>('#consent');

      const RE_NAME = /^[A-Za-zÀ-ÖØ-öø-ÿ' .-]{2,80}$/;
      const RE_ORG = /^[^<>{};`$\\]*$/;
      const RE_EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
      const RE_PHONE = /^\+?[\d\s().-]{9,20}$/;
      const RE_CTRL = /[\u0000-\u001F\u007F]/;

      type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
      const setError = (field: Field, hasError: boolean) => {
        field.setAttribute('aria-invalid', hasError ? 'true' : 'false');
        const err = document.getElementById('err-' + field.id);
        if (err) err.classList.toggle('is-visible', hasError);
      };

      const validators: Array<() => boolean> = [
        () => {
          const v = nameInput!.value.trim();
          const ok = RE_NAME.test(v) && !RE_CTRL.test(v);
          setError(nameInput!, !ok);
          return ok;
        },
        () => {
          const v = orgInput!.value.trim();
          const ok = v === '' || (v.length <= 120 && RE_ORG.test(v) && !RE_CTRL.test(v));
          setError(orgInput!, !ok);
          return ok;
        },
        () => {
          const ok = RE_EMAIL.test(emailInput!.value.trim());
          setError(emailInput!, !ok);
          return ok;
        },
        () => {
          const v = phoneInput!.value.trim();
          const ok = v === '' || (RE_PHONE.test(v) && !RE_CTRL.test(v));
          setError(phoneInput!, !ok);
          return ok;
        },
        () => {
          const ok = !!typeSelect!.value;
          setError(typeSelect!, !ok);
          return ok;
        },
        () => {
          const v = messageInput!.value;
          const ok = v.trim().length >= 20 && v.length <= 2000 && !RE_CTRL.test(v);
          setError(messageInput!, !ok);
          return ok;
        },
        () => {
          const ok = consentInput!.checked;
          setError(consentInput!, !ok);
          return ok;
        },
      ];

      const showStatus = (msg: string, kind: 'is-error' | 'is-success') => {
        status.textContent = msg;
        status.classList.remove('is-error', 'is-success');
        status.classList.add(kind);
        status.hidden = false;
      };

      const livePairs: Array<[Field, () => boolean]> = [
        [nameInput!, validators[0]],
        [emailInput!, validators[2]],
        [phoneInput!, validators[3]],
        [typeSelect!, validators[4]],
        [messageInput!, validators[5]],
      ];
      livePairs.forEach(([field, validate]) => {
        field.addEventListener('blur', () => {
          if (field.value.trim() !== '' || field.tagName === 'SELECT') validate();
        });
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        status.hidden = true;
        const results = validators.map((v) => v());
        const firstInvalid = form.querySelector('[aria-invalid="true"]');
        if (firstInvalid) {
          (firstInvalid as HTMLElement).focus();
          showStatus('Reveja os campos assinalados e tente novamente.', 'is-error');
          return;
        }
        if (results.every(Boolean)) {
          // Envio AJAX para o endpoint próprio (Node + SMTP): confirma na própria
          // página e conserva o contexto do utilizador.
          const fields = [nameInput, orgInput, emailInput, phoneInput, typeSelect, messageInput, consentInput];
          const botfield = form.querySelector<HTMLInputElement>('input[name="bot-field"]');
          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                lang: document.documentElement.lang || 'pt',
                name: nameInput?.value ?? '',
                organisation: orgInput?.value ?? '',
                email: emailInput?.value ?? '',
                phone: phoneInput?.value ?? '',
                type: typeSelect?.value ?? '',
                message: messageInput?.value ?? '',
                consent: consentInput?.checked ?? false,
                botfield: botfield?.value ?? '',
              }),
            });
            if (res.status === 429) {
              showStatus('Demasiadas tentativas. Tente novamente mais tarde ou escreva-nos para info@deepbiodata.com.', 'is-error');
              return;
            }
            if (!res.ok) throw new Error(String(res.status));
            fields.forEach((f) => f && setError(f, false));
            form.reset();
            showStatus('Obrigado: a sua mensagem foi enviada. Responderemos por correio eletrónico.', 'is-success');
          } catch {
            showStatus('Não foi possível enviar a mensagem. Escreva-nos diretamente para info@deepbiodata.com.', 'is-error');
          }
        }
      });
    };
    initForm();
    document.addEventListener('astro:page-load', initForm);
  </script>
</BaseLayout>
