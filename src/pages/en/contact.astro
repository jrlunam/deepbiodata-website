---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Deep Bio Data — collaborations with hospitals, clinical research groups, biomedical institutes and innovation programmes."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="overline">Contact</p>
        <h1>Let’s talk about your project</h1>
        <p class="lede">
          Whether you are exploring predictive models, causal analysis or explainable AI for
          clinical research, we would be glad to discuss how we can help.
        </p>
      </div>

      <div class="contact-layout">
        <form
          name="contact"
          method="POST"
          novalidate
          class="card"
          style="padding: var(--space-6);"
        >
          <p style="display:none;">
            <label>Don't fill this out if you're human: <input name="bot-field" /></label>
          </p>

          <div class="form-grid">
            <div class="form-field">
              <label for="name">Name <span aria-hidden="true">*</span></label>
              <input
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
                maxlength="80"
                aria-describedby="err-name"
              />
              <p class="form-error" id="err-name">Please enter your name (letters and spaces, 2–80 characters).</p>
            </div>

            <div class="form-field">
              <label for="organisation">Organisation</label>
              <input
                id="organisation"
                name="organisation"
                type="text"
                autocomplete="organization"
                maxlength="120"
                aria-describedby="err-organisation"
              />
              <p class="form-error" id="err-organisation">The organisation name contains invalid characters.</p>
            </div>

            <div class="form-field">
              <label for="email">Email <span aria-hidden="true">*</span></label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                spellcheck="false"
                required
                maxlength="254"
                aria-describedby="err-email"
              />
              <p class="form-error" id="err-email">Please enter a valid email address (e.g. name@organisation.com).</p>
            </div>

            <div class="form-field">
              <label for="phone">Phone <span style="color: var(--color-text-muted); font-weight: 400;">(optional)</span></label>
              <input
                id="phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                spellcheck="false"
                inputmode="tel"
                maxlength="20"
                pattern="\+?[\d\s().-]{9,20}"
                aria-describedby="err-phone"
              />
              <p class="form-error" id="err-phone">Please enter a valid phone number (digits, spaces and + ( ) - only).</p>
            </div>

            <div class="form-field">
              <label for="type">Collaboration type <span aria-hidden="true">*</span></label>
              <select id="type" name="collaboration-type" required aria-describedby="err-type">
                <option value="" disabled selected>Select an option</option>
                <option value="hospital">Hospital / clinical research unit</option>
                <option value="institute">Biomedical research institute</option>
                <option value="university">University / academic laboratory</option>
                <option value="programme">Innovation programme (public or private)</option>
                <option value="other">Other</option>
              </select>
              <p class="form-error" id="err-type">Please select a collaboration type.</p>
            </div>

            <div class="form-field form-field--full">
              <label for="message">Message <span aria-hidden="true">*</span></label>
              <textarea
                id="message"
                name="message"
                required
                minlength="20"
                maxlength="2000"
                aria-describedby="err-message hint-message"></textarea>
              <span class="hint" id="hint-message">Tell us briefly about your data, your goals and your timeline (20–2000 characters).</span>
              <p class="form-error" id="err-message">Please write a message between 20 and 2000 characters.</p>
            </div>

            <div class="form-field form-field--full">
              <div class="consent">
                <input id="consent" name="consent" type="checkbox" required aria-describedby="err-consent" />
                <label for="consent">
                  I have read and accept the <a href="/privacy-policy">Privacy Policy</a> and
                  consent to the processing of my data to respond to this enquiry. *
                </label>
              </div>
              <p class="form-error" id="err-consent">Please accept the Privacy Policy to continue.</p>
            </div>

            <div class="form-field form-field--full">
              <button class="btn btn--primary" type="submit">Send message</button>
            </div>
          </div>

          <p class="form-status" role="alert" hidden></p>
        </form>

        <aside class="card" style="padding: var(--space-6);">
          <h3 style="margin-top:0;">Prefer direct contact?</h3>
          <p style="color: var(--color-text-muted); font-size: var(--fs-small);">
            Reach out through either channel.
          </p>

          <div class="contact-method">
            <span class="contact-method__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </span>
            <div class="contact-method__text">
              <h3>Email us</h3>
              <a href="mailto:info@deepbiodata.com">info@deepbiodata.com</a>
              <p>Best for detailed project descriptions and attachments.</p>
            </div>
          </div>

          <div class="contact-method">
            <span class="contact-method__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z"/></svg>
            </span>
            <div class="contact-method__text">
              <h3>Call us</h3>
              <a href="tel:+351965636559">+351 965 636 559</a>
              <p>Direct line to the team for a first conversation.</p>
            </div>
          </div>

          <div class="contact-method">
            <span class="contact-method__icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </span>
            <div class="contact-method__text">
              <h3>Visit us</h3>
              <a
                href="https://www.google.com/maps/search/?api=1&amp;query=Rua%20Hermano%20Neves%2018%2C%201600-477%20Lisboa%2C%20Portugal"
                target="_blank"
                rel="noopener"
              >Rua Hermano Neves, Número 18, 3, Escritório 7, V6113<br />1600-477 Lisboa, Portugal</a>
              <p>Our office in Lisbon.</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const initForm = () => {
    const form = document.querySelector<HTMLFormElement>('form[name="contact"]');
    if (!form || form.hasAttribute('data-form-bound')) return;
    form.setAttribute('data-form-bound', '1');
    const status = form.querySelector('.form-status') as HTMLElement;
    const nameInput = form.querySelector<HTMLInputElement>('#name');
    const orgInput = form.querySelector<HTMLInputElement>('#organisation');
    const emailInput = form.querySelector<HTMLInputElement>('#email');
    const phoneInput = form.querySelector<HTMLInputElement>('#phone');
    const typeSelect = form.querySelector<HTMLSelectElement>('#type');
    const messageInput = form.querySelector<HTMLTextAreaElement>('#message');
    const consentInput = form.querySelector<HTMLInputElement>('#consent');

    const RE_NAME = /^[A-Za-zÀ-ÖØ-öø-ÿ' .-]{2,80}$/;
    const RE_ORG = /^[^<>{};`$\\]*$/;
    const RE_EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    const RE_PHONE = /^\+?[\d\s().-]{9,20}$/;
    const RE_CTRL = /[\u0000-\u001F\u007F]/;

    type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    const setError = (field: Field, hasError: boolean) => {
      field.setAttribute('aria-invalid', hasError ? 'true' : 'false');
      const err = document.getElementById('err-' + field.id);
      if (err) err.classList.toggle('is-visible', hasError);
    };

    const validators: Array<() => boolean> = [
      () => {
        const v = nameInput!.value.trim();
        const ok = RE_NAME.test(v) && !RE_CTRL.test(v);
        setError(nameInput!, !ok);
        return ok;
      },
      () => {
        const v = orgInput!.value.trim();
        const ok = v === '' || (v.length <= 120 && RE_ORG.test(v) && !RE_CTRL.test(v));
        setError(orgInput!, !ok);
        return ok;
      },
      () => {
        const ok = RE_EMAIL.test(emailInput!.value.trim());
        setError(emailInput!, !ok);
        return ok;
      },
      () => {
        const v = phoneInput!.value.trim();
        const digits = v.replace(/\D/g, '');
        const ok = v === '' || (RE_PHONE.test(v) && digits.length >= 9 && digits.length <= 15);
        setError(phoneInput!, !ok);
        return ok;
      },
      () => {
        const ok = typeSelect!.value !== '';
        setError(typeSelect!, !ok);
        return ok;
      },
      () => {
        const v = messageInput!.value.trim();
        const ok = v.length >= 20 && v.length <= 2000 && !RE_CTRL.test(v.replace(/[\t\n\r]/g, ''));
        setError(messageInput!, !ok);
        return ok;
      },
      () => {
        const ok = consentInput!.checked;
        setError(consentInput!, !ok);
        return ok;
      },
    ];

    const liveChecks: Array<[Field, () => boolean]> = [
      [nameInput!, validators[0]],
      [emailInput!, validators[2]],
      [phoneInput!, validators[3]],
      [typeSelect!, validators[4]],
      [messageInput!, validators[5]],
    ];
    for (const [field, check] of liveChecks) {
      field.addEventListener('blur', () => {
        if (field.value !== '' || field.getAttribute('aria-invalid') === 'true') {
          check();
        }
      });
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') {
          check();
        }
      });
    }

    const showStatus = (msg: string, kind: 'is-error' | 'is-success') => {
      status.textContent = msg;
      status.className = 'form-status ' + kind;
      status.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.hidden = true;
      const results = validators.map((v) => v());
      const firstInvalid = form.querySelector('[aria-invalid="true"]');
      if (firstInvalid) {
        (firstInvalid as HTMLElement).focus();
        showStatus('Please correct the highlighted fields and try again.', 'is-error');
        return;
      }
        if (results.every(Boolean)) {
          // Envío AJAX al endpoint propio (Node + SMTP): confirma en la propia
          // página y conserva el contexto del usuario.
          const fields = [nameInput, orgInput, emailInput, phoneInput, typeSelect, messageInput, consentInput];
          const botfield = form.querySelector<HTMLInputElement>('input[name="bot-field"]');
          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                lang: document.documentElement.lang || 'en',
                name: nameInput?.value ?? '',
                organisation: orgInput?.value ?? '',
                email: emailInput?.value ?? '',
                phone: phoneInput?.value ?? '',
                type: typeSelect?.value ?? '',
                message: messageInput?.value ?? '',
                consent: consentInput?.checked ?? false,
                botfield: botfield?.value ?? '',
              }),
            });
            if (res.status === 429) {
              showStatus('Too many attempts. Please try again later or email us directly at info@deepbiodata.com.', 'is-error');
              return;
            }
            if (!res.ok) throw new Error(String(res.status));
            fields.forEach((f) => f && setError(f, false));
            form.reset();
            showStatus('Thank you — your message has been sent. We will get back to you by email.', 'is-success');
          } catch {
            showStatus('Something went wrong while sending. Please email us directly at info@deepbiodata.com.', 'is-error');
          }
        }
    });
  };
  initForm();
  document.addEventListener('astro:page-load', initForm);
</script>
