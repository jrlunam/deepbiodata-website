# Configuración de producción del servidor Linux.
# Copiar a deploy/.env (quedará fuera del repositorio: está en .gitignore)
# y rellenar los valores entre <...>. Permisos recomendados: chmod 600.

# ── Servidor Node (adaptador standalone de Astro) ────────────────────────────
HOST=127.0.0.1
PORT=4321

# ── SMTP para el formulario de contacto (src/pages/api/contact.ts) ──────────
# Sin estas variables el endpoint responde 503 y el visitante ve el mensaje
# de contacto alternativo (info@deepbiodata.com).
SMTP_HOST=<host-smtp, p. ej. smtp.eu.email>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<usuario-smtp, p. ej. web@deepbiodata.com>
SMTP_PASS=<contraseña-smtp>
SMTP_FROM=<remitente, p. ej. Deep Bio Data <web@deepbiodata.com>>

# Buzón donde llegan los mensajes del formulario.
CONTACT_TO=info@deepbiodata.com
